# The game and Web application are independent projects. The Web JAR and
# integration scripts are resources checked into this DNF build context.
ARG DNF_IMAGE=dnf-game:local
ARG JAVA_IMAGE=eclipse-temurin:21-jdk
FROM ${JAVA_IMAGE} AS java
FROM ${DNF_IMAGE}
COPY --from=java /opt/java/openjdk/ /opt/dnf-admin/jre/
COPY build/Centos7-DNF/web/dnf-admin.jar /opt/dnf-admin/app.jar
COPY build/Centos7-DNF/web/init.sql /opt/dnf-admin/init.sql
COPY build/Centos7-DNF/web/integration/ /opt/dnf-admin/
COPY build/dnf_data/docker-entrypoint.sh /docker-entrypoint.sh.upstream
COPY build/dnf_data/home/template/init/init.sh /home/template/init/init.sh.upstream
RUN rm -f /etc/supervisor/conf.d/gate.conf /home/template/root/DnfGateServer \
      /home/template/root/GateRestart /home/template/root/GateStop /home/template/init/Config.ini \
      /root/DnfGateServer /root/GateRestart /root/GateStop /root/Config.ini /root/privatekey.pem \
    && cp /opt/dnf-admin/init-wrapper.sh /home/template/init/init.sh \
    && cp /opt/dnf-admin/entrypoint-wrapper.sh /docker-entrypoint.sh \
    && cp /opt/dnf-admin/web.conf /etc/supervisor/conf.d/dnf-admin.conf \
    && chmod +x /docker-entrypoint.sh /home/template/init/init.sh /opt/dnf-admin/*.sh /opt/dnf-admin/*.py \
    && python /opt/dnf-admin/patch_monitor.py
EXPOSE 9001
